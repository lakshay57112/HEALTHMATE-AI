# ─── HealthMate AI · environment variables ───────────────────────────────────
# Copy to `backend/.env` (local) or `.env` next to docker-compose.yml. Never commit real secrets.

# Core
ENVIRONMENT=development                 # development | production | test
FRONTEND_ORIGIN=http://localhost:3000   # used for CORS and invitation links
DATABASE_URL=postgresql+psycopg://healthmate:healthmate@localhost:5432/healthmate

# Security — generate strong values for production
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
COOKIE_SECURE=false                     # true behind HTTPS
# Fernet key for encrypting documents and sensitive fields at rest.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset in development, a key is generated into backend/.data/dev_encryption.key
ENCRYPTION_KEY=

# AI provider: demo | openai | gemini
# demo = fully offline rule-based extraction + deterministic assistant (clearly labelled in the UI)
LLM_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# OCR (Tesseract must be installed with eng + hin language data)
OCR_LANGUAGES=eng+hin
TESSERACT_CMD=

# Web Push (optional). Generate with: python backend/scripts/generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Reminder engine
REMINDER_ENGINE_ENABLED=true
REMINDER_TICK_SECONDS=60
DEFAULT_TIMEZONE=Asia/Kolkata

# Agent harness
AGENT_MAX_STEPS=6

# Frontend (Next.js) — where the API lives, used by the /api rewrite
BACKEND_URL=http://127.0.0.1:8000
